{
  "name": "contextos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx apps/daemon/src/main.ts",
    "start": "node dist/apps/daemon/src/main.js",
    "start:local": "powershell -ExecutionPolicy Bypass -File scripts/start-contextos.ps1",
    "build": "tsc -p tsconfig.json",
    "build:all": "npm run build && npm run frontend:build",
    "frontend:dev": "vite",
    "frontend:typecheck": "tsc -p frontend/tsconfig.json",
    "frontend:build": "npm run frontend:typecheck && vite build",
    "frontend:preview": "vite preview --host 127.0.0.1",
    "e2e:server": "tsx scripts/start-e2e-server.ts",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/infrastructure/src/sqlite/migrations.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "better-sqlite3": "^13.0.3",
    "diff": "^8.0.4",
    "drizzle-orm": "^0.33.0",
    "fastify": "^4.28.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.1"
  }
}
